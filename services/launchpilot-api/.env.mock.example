# LaunchPilot 로컬 플랫폼 mock 전용 설정
# 실제 Google·Meta Client ID, Client Secret, Developer Token을 넣지 않는다.

DATABASE_URL=postgresql://launchpilot:launchpilot-local@127.0.0.1:5432/launchpilot_mock
GOOGLE_API_KEY=mock-google-ai-key
GOOGLE_GENAI_USE_VERTEXAI=false
LLM_MODEL=gemini-3.6-flash
PUBLIC_BASE_URL=http://127.0.0.1:8000
COOKIE_SECURE=false
PLATFORM_MOCK_BASE_URL=http://127.0.0.1:9000
META_PRIMARY_CONVERSION_ACTION=purchase

# 로컬 mock 데이터 암호화와 세션 서명에만 쓰는 공개된 개발용 값이다.
# 실제 환경에서 재사용하면 안 된다.
APP_SESSION_SECRET=launchpilot-local-mock-session-secret-only
TOKEN_ENCRYPTION_KEY=bGF1bmNocGlsb3QtbW9jay1mZXJuZXQta2V5LTAwMDE=
