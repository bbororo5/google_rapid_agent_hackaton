# LaunchPilot API 환경변수 예시
# 이 파일은 설명용이다. 실제 비밀값은 Git에서 제외된 .env에 저장한다.

# PostgreSQL 연결 문자열. 로컬 compose 기본값이며 배포 환경에서는 별도 비밀값을 사용한다.
DATABASE_URL=postgresql://launchpilot:launchpilot-local@127.0.0.1:5432/launchpilot
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=launchpilot-documents-v1

# OpenInference와 OpenTelemetry 자동 계측을 켜는 스위치다.
# false일 때는 외부로 trace를 전송하지 않는다.
TELEMETRY_ENABLED=false
OTEL_SERVICE_NAME=launchpilot-api

# LangSmith에 직접 보낼 때 사용하는 OTLP/HTTP 주소와 인증 헤더다.
# TELEMETRY_ENABLED=true일 때 endpoint가 반드시 필요하다.
# APAC 계정은 https://apac.api.smith.langchain.com/otel 을 사용한다.
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.smith.langchain.com/otel
# 예: x-api-key=lsv2_...,Langsmith-Project=launchpilot-eval-v1
OTEL_EXPORTER_OTLP_HEADERS=

# 권장: 배포와 동일한 Vertex AI + Application Default Credentials(ADC)를 사용한다.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# 대안: Google AI Studio를 쓸 때만 Vertex AI를 false로 바꾸고 입력한다.
# Google OAuth Client Secret과 다른 값이다.
GOOGLE_API_KEY=

# 재현 가능한 stable model ID를 명시한다.
LLM_MODEL=gemini-3.6-flash

# OAuth callback을 만들 때 사용하는 FastAPI 외부 주소다.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# 로컬 HTTP에서는 false, 실제 HTTPS 배포에서는 true로 설정한다.
COOKIE_SECURE=false

# Google Cloud Console에서 발급받은 Web OAuth Client다.
# 앱 로그인, YouTube, Google Ads 권한 승인에 함께 사용한다.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google Ads API Center에서 발급받은 Developer Token이다.
# OAuth 토큰과 별개이며 모든 Google Ads API 요청에 필요하다.
GOOGLE_ADS_DEVELOPER_TOKEN=

# 프로젝트가 검증한 Google Ads REST 버전이다. 업그레이드는 명시적으로 한다.
GOOGLE_ADS_API_VERSION=v25

# Meta for Developers 앱의 ID와 Secret이다.
META_APP_ID=
META_APP_SECRET=

# 프로젝트가 검증할 Meta Graph API 버전이다. 업그레이드는 명시적으로 한다.
META_GRAPH_API_VERSION=v24.0

# 선택값. Meta actions 중 공통 conversions로 취급할 대표 action_type이다.
# 비워두면 action을 원본 key로만 저장해 잘못된 전환 합산을 방지한다.
# 예: purchase 또는 offsite_conversion.fb_pixel_purchase
META_PRIMARY_CONVERSION_ACTION=

# 선택값. 세 플랫폼과 OAuth를 로컬 mock 서버로 전환한다.
# 실제 플랫폼을 사용할 때는 비워둔다. mock 전용 설정은 .env.mock.example을 사용한다.
PLATFORM_MOCK_BASE_URL=

# LaunchPilot이 자체 생성하는 서로 다른 두 비밀키다.
# APP_SESSION_SECRET: 로그인 세션과 OAuth state HMAC 서명용(최소 32자)
# TOKEN_ENCRYPTION_KEY: 외부 플랫폼 토큰 Fernet 암호화용
APP_SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
