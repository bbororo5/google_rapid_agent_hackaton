DATABASE_PATH=./data/launchpilot.db
PUBLIC_BASE_URL=http://127.0.0.1:8000
COOKIE_SECURE=false

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google Ads API access. v25 is the current REST version used by this project.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v25

# Meta Graph API version is pinned so API upgrades are explicit.
META_GRAPH_API_VERSION=v24.0
META_APP_ID=
META_APP_SECRET=

# Generate independently; never commit real values.
APP_SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
